{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "rootDir": "src",
    "outDir": "dist",
    "types": [ "node" ],
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noEmitOnError": true
  },
  "include": [ "src" ]
}
